{
  "name": "deadwood-solo-open",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deadwood Solo Open: a single-player 3D survival FPS executed entirely in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve-solo.mjs",
    "build": "node scripts/build-solo.mjs",
    "test:solo": "node --test test/solo-transport.test.mjs test/solo-build.test.mjs test/save-game.test.mjs test/save-sheets.test.mjs",
    "start:original": "node server.mjs",
    "start:lan": "node lan-gateway.mjs",
    "start:supermarket": "node start-supermarket.mjs",
    "start:hospital": "node start-hospital.mjs",
    "start:funfair": "node start-funfair.mjs",
    "dev": "node --watch server.mjs",
    "build:online": "node online-client-build.mjs",
    "start:online": "node online-client-build.mjs && node online-gateway.mjs",
    "companions": "node companion-brain/brain.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "three": "0.180.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
